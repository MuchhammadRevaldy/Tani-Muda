# Dependensi dan hasil build
node_modules/
dist/
dist-demo/
dist-demo-backend/
coverage/

# Rahasia: hanya .env.example yang masuk repo
.env
.env.*
!.env.example

# Backend Laravel (backend/.gitignore memuat sisanya). Isi backend/storage diabaikan oleh berkas
# .gitignore di tiap subfoldernya, sehingga struktur folder yang dibutuhkan Laravel tetap ikut.
backend/vendor/
backend/.env
backend/.phpunit.cache/
backend/database/*.sqlite

# Bahan kerja hasil bongkar desain (buat ulang dengan `npm run ekstrak-desain`)
design/extracted/

# Lain-lain
*.log
.DS_Store
Thumbs.db
# Tangkapan sementara (tangkapan untuk pemilik produk disimpan di docs/tangkapan/)
.tangkapan-sementara/
# Catatan uji:naskah
frontend/uji-*/
catatan-*/
frontend/catatan-*/

# Video teaser Remotion (AG-42): rekaman mentah Playwright dan hasil render
video/rekaman/
video/public/rekaman/
video/keluaran/
video/node_modules/
video/.remotion/
