# Salin menjadi .env lalu jalankan `php artisan key:generate`. Berkas ini tidak berisi nilai rahasia;
# .env tidak pernah di-commit dan isinya tidak pernah dikirim ke frontend (arsitektur-backend.md 1).

APP_NAME="Tani Muda"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Alamat frontend: dipakai CORS dan tautan ke aplikasi.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
# Aplikasi dan basis data selalu UTC (D-31); ini zona tampilan bawaan pengguna baru.
APP_ZONA_WAKTU_TAMPILAN=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB dari XAMPP (D-25, D-50). Basis data tes `tani_muda_uji` diatur di phpunit.xml.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tani_muda
DB_USERNAME=root
DB_PASSWORD=

# Sesi cookie Sanctum mode SPA (D-21). Dengan proxy Vite, peramban hanya melihat localhost:5173.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# Kosong = FRONTEND_URL. Beberapa asal dipisah koma.
CORS_ALLOWED_ORIGINS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Hemat memori di laptop pengembangan: antrean langsung dijalankan (arsitektur-backend.md 2b).
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

# Pengirim OTP: log (lokal saja; kode tertulis di storage/logs/laravel.log)
OTP_DRIVER=log

# Resep contoh terlihat petani: true untuk demo dan uji coba, false di produksi (D-12)
TAMPILKAN_RESEP_CONTOH=false

# Penyedia pembayaran: tiruan (mode uji coba, D-10)
PEMBAYARAN_DRIVER=tiruan
