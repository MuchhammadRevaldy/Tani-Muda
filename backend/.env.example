# Salin menjadi .env lalu jalankan `php artisan key:generate`. Berkas ini tidak berisi nilai rahasia;
# .env tidak pernah di-commit dan isinya tidak pernah dikirim ke frontend (arsitektur-backend.md 1).

APP_NAME="Tani Muda"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Alamat frontend: dipakai CORS dan tautan ke aplikasi.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
# Aplikasi dan basis data selalu UTC (D-31); ini zona tampilan bawaan pengguna baru.
APP_ZONA_WAKTU_TAMPILAN=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB dari XAMPP (D-25, D-50). Basis data tes `tani_muda_uji` diatur di phpunit.xml.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tani_muda
DB_USERNAME=root
DB_PASSWORD=

# Sesi cookie Sanctum mode SPA (D-21). Dengan proxy Vite, peramban hanya melihat localhost:5173.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:4174,127.0.0.1:4174
# Kosong = FRONTEND_URL. Beberapa asal dipisah koma.
CORS_ALLOWED_ORIGINS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Hemat memori di laptop pengembangan: antrean langsung dijalankan (arsitektur-backend.md 2b).
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

# Pengirim OTP: log (lokal saja; kode tertulis di storage/logs/laravel.log)
OTP_DRIVER=log

# Wilayah provinsi aktif (D-67, AG-41): 33 = Jawa Tengah
WILAYAH_PROVINSI_AKTIF=33

# Resep contoh terlihat petani: true untuk demo dan uji coba, false di produksi (D-12)
TAMPILKAN_RESEP_CONTOH=false

# Penyedia pembayaran: tiruan (mode uji coba, D-10)
PEMBAYARAN_DRIVER=tiruan

# ---------------------------------------------------------------- Tahap 7: Fitur Tambahan (D-64)
# Sakelar fitur backend (true/false)
FITUR_AI=true
FITUR_SARAN_UNTUNG=true
FITUR_TANAMAN_BARU=true
FITUR_LEVEL=true
FITUR_DETEKSI=true
FITUR_CHATBOT=true
FITUR_CUACA=true
FITUR_STOK=true
FITUR_PETA=true
FITUR_CHAT=true
FITUR_HARGA_BERITA=true
FITUR_SARAN_HARIAN=true

# ==============================================================================
# KONFIGURASI API EKSTERNAL (GNews, Open-Meteo, Dattio AI)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API GNEWS (Penyedia Berita & Harga Panen Komoditas Pasar)
# ------------------------------------------------------------------------------
# Driver: 'gnews' (aktifkan API asli), 'google' (Google Custom Search), atau 'tiruan'
BERITA_DRIVER=tiruan
# Alamat URL / Endpoint GNews
GNEWS_BASE_URL=https://gnews.io/api/v4/search
# Kunci API GNews (dapatkan di https://gnews.io/)
BERITA_API_KEY=

# ------------------------------------------------------------------------------
# 2. API OPEN-METEO (Prakiraan Cuaca Desa & Kecocokan Suhu Siklus Tanaman)
# ------------------------------------------------------------------------------
# Alamat URL / Endpoint Open-Meteo (default publik: https://api.open-meteo.com/v1/forecast)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# Kunci API Open-Meteo (kosongkan jika memakai tier publik gratis Open-Meteo)
OPEN_METEO_API_KEY=

# ------------------------------------------------------------------------------
# 3. API DATTIO / OPENAI (Deteksi Penyakit AI, Chatbot RAG, Rekomendasi Tanaman)
# ------------------------------------------------------------------------------
# Driver: 'openai' (untuk Dattio atau endpoint OpenAI-compatible) atau 'tiruan'
AI_DRIVER=tiruan
# Alamat URL / Endpoint API Dattio (format: https://.../v1)
AI_BASE_URL=https://bandelbanget.xyz/v1
# Kunci API Dattio / OpenAI (dapatkan di https://dattioai.com/docs)
OPENAI_API_KEY=
# Nama Model AI Teks & Chatbot (misal: glm-5.2, deepseek-v4-flash, gpt-4o)
AI_MODEL_TEKS=glm-5.2
# Nama Model AI Gambar / Vision (misal: glm-5.3-flash)
AI_MODEL_GAMBAR=glm-5.3-flash
# Nama Model AI Embedding (opsional; bila kosong otomatis fallback ke pencarian kata kunci PHP)
AI_MODEL_EMBEDDING=
# Batas kuota panggilan AI per hari per pengguna
AI_BATAS_HARIAN=100


