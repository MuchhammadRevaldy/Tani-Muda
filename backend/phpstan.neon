# Analisis statis (D-54): Larastan dengan sintaks dan fungsi PHP 8.3, versi PHP di VPS (D-53).
# Laptop memakai PHP 8.5, jadi pemeriksaan ini yang menolak fitur 8.4+ (property hooks,
# asymmetric visibility, array_find, `new Kelas()->metode()` tanpa kurung, dan sejenisnya).
# Naikkan `level` bila kode sudah lolos di level berikutnya; jangan turunkan.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    phpVersion: 80300
    level: 5
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
