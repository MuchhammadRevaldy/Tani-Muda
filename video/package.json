{
  "name": "tani-muda-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "siapkan-tts": "python -m venv .venv-tts && .venv-tts\\Scripts\\python -m pip install edge-tts==7.2.3 imageio-ffmpeg==0.6.0",
    "narasi": "node scripts/buat-narasi.mjs",
    "musik": "node scripts/buat-musik.mjs",
    "cek": "node scripts/cek-ikon-aplikasi.mjs && node scripts/cek-durasi.mjs",
    "cek-durasi": "node scripts/cek-durasi.mjs",
    "pratinjau-ikon": "remotion still src/index.ts PratinjauIkon keluaran/pratinjau-ikon.png",
    "papan-gaya": "node scripts/buat-papan-gaya.mjs",
    "pratinjau": "node scripts/render-teaser.mjs --pratinjau",
    "render": "node scripts/render-teaser.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/media-utils": "4.0.536",
    "@remotion/paths": "^4.0.536",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^5.6.3"
  }
}
