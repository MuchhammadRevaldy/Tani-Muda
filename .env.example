# Salin menjadi .env lalu isi. Jangan pernah commit .env.
# Hanya variabel berawalan VITE_ yang sampai ke browser, dan semuanya terbuka untuk publik.
# Service role key Supabase TIDAK BOLEH ada di sini; simpan sebagai rahasia Edge Function.

# Supabase (URL proyek dan anon key; keduanya publik, hak akses dijaga RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web push: kunci publik VAPID saja (kunci privat hanya di Edge Function)
VITE_VAPID_PUBLIC_KEY=

# Tampilkan resep contoh berstatus draf (keputusan D-12). Bawaan mati.
# Isi persis `true` hanya untuk demo; kosong atau nilai lain berarti mati.
VITE_TAMPILKAN_RESEP_CONTOH=
