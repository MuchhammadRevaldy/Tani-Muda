# Salin menjadi .env lalu isi. Jangan pernah commit .env.
# Ini .env FRONTEND: hanya variabel publik berawalan VITE_, karena semuanya ikut ke bundel dan
# terbuka di browser. Kunci rahasia (APP_KEY, DB_PASSWORD, VAPID_PRIVATE_KEY, kunci pembayaran)
# hanya ada di .env backend Laravel dan tidak pernah dikirim ke frontend (keputusan D-19).
# `npm run lint` menolak variabel selain VITE_* atau nama yang tampak rahasia di file ini.

# Sumber data klien API (D-20): `tiruan` (bawaan, data contoh di browser) atau `http`
# (backend Laravel, tersedia mulai Tahap 6).
VITE_SUMBER_DATA=tiruan

# Web push: kunci publik VAPID saja (kunci privat hanya di .env backend)
VITE_VAPID_PUBLIC_KEY=

# Tampilkan resep contoh berstatus draf (keputusan D-12). Bawaan mati.
# Isi persis `true` hanya untuk demo; kosong atau nilai lain berarti mati.
VITE_TAMPILKAN_RESEP_CONTOH=

# Animasi antarmuka (D-61): kosong atau `nyala` = menyala; `mati` = semua animasi mati, setara
# prefers-reduced-motion. Untuk build demo, sakelarnya di scripts/pengaturan-demo.mjs.
VITE_ANIMASI=

# ---------------------------------------------------------------- Tahap 7: Sakelar Fitur (D-64)
# Kosong atau `nyala` = fitur menyala; `mati` = fitur dimatikan.
VITE_FITUR_AI=
VITE_FITUR_SARAN_UNTUNG=
VITE_FITUR_TANAMAN_BARU=
VITE_FITUR_LEVEL=
VITE_FITUR_DETEKSI=
VITE_FITUR_CHATBOT=
VITE_FITUR_CUACA=
VITE_FITUR_STOK=
VITE_FITUR_PETA=
VITE_FITUR_CHAT=
VITE_FITUR_HARGA_BERITA=
VITE_FITUR_SARAN_HARIAN=

VITE_VAPID_PUBLIC_KEY=BNhruQvR2sQL-Teu5u1oS5PJIWyDG1_g04QGzkvdH3sG9xCoERohwonZ2P8x5-w76WlMDC3qrCweszmY_7TytR4


